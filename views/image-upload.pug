extends layout

block content
  style.
    .cf-header { background: var(--kibana-header); border-bottom: 1px solid var(--kibana-border); padding: 0 16px; height: 48px; display: flex; align-items: center; justify-content: space-between; }
    .cf-header .brand { display: flex; align-items: center; gap: 10px; font-weight: 600; }
    .cf-header .brand i { color: var(--kibana-accent); }
    .cf-header .actions { display: flex; align-items: center; gap: 8px; }
    .cf-back, .cf-logout { background: transparent; border: 1px solid var(--kibana-border); color: var(--kibana-text); padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 12px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .cf-back:hover, .cf-logout:hover { border-color: var(--kibana-accent); color: var(--kibana-accent); }
    .iu-wrap { margin: 0; max-width: none; padding: 0; width: 100%; }
    .iu-grid { display: block; width: 100%; }
    .iu-card { background: var(--kibana-sidebar); border: 0; border-bottom: 1px solid var(--kibana-border); border-radius: 0; padding: 24px; width: 100%; }
    .iu-card-title { font-size: 14px; font-weight: 700; margin: 0 0 6px; }
    .iu-tabs { border-bottom: 1px solid var(--kibana-border); display: flex; gap: 4px; margin: 0; }
    .iu-tab { background: transparent; border: 0; border-bottom: 2px solid transparent; color: var(--kibana-text-muted); cursor: pointer; font-size: 13px; font-weight: 600; padding: 10px 14px; }
    .iu-tab:hover { color: var(--kibana-text); }
    .iu-tab.active { border-bottom-color: var(--kibana-accent); color: var(--kibana-accent); }
    .iu-tab-panel { display: none; }
    .iu-tab-panel.active { display: block; }
    .iu-grid.iu-tab-panel.active { display: block; }
    .iu-help { color: var(--kibana-text-muted); font-size: 12px; line-height: 1.6; margin: 0 0 18px; }
    .iu-dropzone { border: 1px dashed var(--kibana-text-muted); border-radius: 8px; box-sizing: border-box; display: block; padding: 48px 20px; text-align: center; cursor: pointer; transition: border-color .2s, background .2s; width: 100%; }
    .iu-dropzone:hover, .iu-dropzone.dragover { border-color: var(--kibana-accent); background: rgba(54,162,239,.08); }
    .iu-dropzone i { color: var(--kibana-accent); font-size: 28px; margin-bottom: 12px; }
    .iu-dropzone strong { display: block; font-size: 14px; margin-bottom: 6px; }
    .iu-dropzone span { color: var(--kibana-text-muted); font-size: 12px; }
    .iu-file-input { display: none; }
    .iu-file-list { display: grid; gap: 8px; margin: 18px 0 0; }
    .iu-selection-summary { align-items: center; background: var(--kibana-bg); border: 1px solid var(--kibana-border); border-radius: 6px; display: flex; gap: 10px; padding: 12px; }
    .iu-selection-summary i { color: var(--kibana-accent); }
    .iu-selection-summary strong { font-size: 13px; }
    .iu-selection-summary span { color: var(--kibana-text-muted); font-size: 11px; margin-left: auto; }
    .iu-file { align-items: center; background: var(--kibana-bg); border: 1px solid var(--kibana-border); border-radius: 6px; display: flex; gap: 10px; justify-content: space-between; padding: 10px 12px; }
    .iu-file-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .iu-file-size { color: var(--kibana-text-muted); flex: 0 0 auto; font-family: 'JetBrains Mono', monospace; font-size: 11px; }
    .iu-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px; }
    .iu-button { background: var(--kibana-accent); border: 0; border-radius: 6px; color: #fff; cursor: pointer; font-size: 13px; font-weight: 600; padding: 10px 16px; }
    .iu-button:disabled { cursor: not-allowed; opacity: .55; }
    .iu-button.secondary { background: transparent; border: 1px solid var(--kibana-border); color: var(--kibana-text); }
    .iu-steps { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
    .iu-step { align-items: flex-start; color: var(--kibana-text-muted); display: flex; font-size: 12px; gap: 10px; line-height: 1.4; }
    .iu-step i { color: var(--kibana-accent); margin-top: 2px; width: 14px; }
    .iu-status { border-radius: 6px; display: none; font-size: 12px; line-height: 1.5; margin-top: 16px; padding: 10px 12px; }
    .iu-status.show { display: block; }
    .iu-status.ok { background: rgba(125,226,209,.12); border: 1px solid rgba(125,226,209,.3); color: var(--kibana-success); }
    .iu-status.err { background: rgba(255,107,107,.12); border: 1px solid rgba(255,107,107,.3); color: var(--kibana-error); }
    .iu-results { margin-top: 20px; overflow-x: auto; }
    .iu-results > .iu-card { padding: 0; border: 0; }
    .iu-results table, .iu-log-items table { border-collapse: collapse; min-width: 760px; width: 100%; }
    .iu-results th, .iu-results td, .iu-log-items th, .iu-log-items td { border-bottom: 1px solid var(--kibana-border); padding: 10px; text-align: left; vertical-align: top; }
    .iu-results th, .iu-log-items th { color: var(--kibana-text-muted); font-size: 10px; text-transform: uppercase; }
    .iu-results td, .iu-log-items td { font-size: 12px; }
    .iu-results a, .iu-log-items a { color: var(--kibana-accent); }
    .iu-badge { border-radius: 4px; display: inline-block; font-size: 10px; padding: 3px 6px; text-transform: uppercase; }
    .iu-badge.uploaded { background: rgba(125,226,209,.14); color: var(--kibana-success); }
    .iu-badge.duplicate-skipped { background: rgba(245,166,35,.14); color: var(--kibana-warning); }
    .iu-badge.failed { background: rgba(255,107,107,.14); color: var(--kibana-error); }
    .iu-log-id { color: var(--kibana-accent); font-family: 'JetBrains Mono', monospace; font-size: 11px; }
    .iu-wrap .log-row:focus-visible { outline: 2px solid var(--kibana-accent); outline-offset: -2px; }
    .iu-log-summary { align-items: center; border-bottom: 1px solid var(--kibana-border); display: grid; gap: 8px 24px; grid-template-columns: minmax(160px, 1fr) repeat(3, minmax(110px, auto)); padding: 0 0 12px; }
    .iu-log-summary-item { align-items: baseline; display: flex; gap: 8px; min-width: 0; }
    .iu-log-summary-label { color: var(--kibana-text-muted); flex: 0 0 auto; font-size: 11px; font-weight: 600; text-transform: uppercase; }
    .iu-log-summary-value { font-family: 'JetBrains Mono', monospace; font-size: 12px; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .iu-log-items { margin-top: 16px; overflow-x: auto; width: 100%; }
    .iu-log-empty { color: var(--kibana-text-muted); padding: 32px; text-align: center; }
    #logsPanel { width: 100%; }
    @media (max-width: 760px) { .iu-card { padding: 16px; } .iu-log-summary { grid-template-columns: 1fr 1fr; } .iu-log-summary-item:first-child { grid-column: 1 / -1; } }

  .cf-header
    .brand
      i.fas.fa-images
      span Image Upload Utility
    .actions
      a.cf-back(href="/select")
        i.fas.fa-arrow-left
        span Back
      form(method="POST" action="/auth/logout" style="display:inline;")
        button.cf-logout(type="submit")
          i.fas.fa-sign-out-alt
          span Logout

  .iu-wrap
    .iu-tabs(role="tablist" aria-label="Image upload utility sections")
      button.iu-tab.active#utilityTab(type="button" role="tab" aria-selected="true" aria-controls="utilityPanel") Utility
      button.iu-tab#logsTab(type="button" role="tab" aria-selected="false" aria-controls="logsPanel") Logs

    .iu-grid.iu-tab-panel.active#utilityPanel(role="tabpanel" aria-labelledby="utilityTab")
      .iu-card
        h2.iu-card-title Choose images
        p.iu-help Unit names are read from the filename without its extension, and underscores are converted to slashes. For example, #[code CHLB_17_1701.jpg] looks up unit #[code CHLB/17/1701]. Select up to 100 images, each up to 20 MB. Images are sent automatically in batches of five.
        form#imageUploadForm(enctype="multipart/form-data")
          label.iu-dropzone#dropzone(for="images")
            i.fas.fa-cloud-upload-alt
            strong Drop images here or choose files
            span JPG, PNG, WEBP, GIF, or other image files
          input.iu-file-input#images(type="file" name="images" accept="image/*" multiple)
          .iu-file-list#fileList
          .iu-actions
            button.iu-button.secondary#clearButton(type="button" disabled) Clear
            button.iu-button#uploadButton(type="submit" disabled)
              i.fas.fa-upload.me-2
              | Start upload
          #uploadStatus.iu-status
        #results

    #logsPanel.iu-tab-panel(role="tabpanel" aria-labelledby="logsTab" hidden)
      form#uploadLogSearchForm.search-bar
        .search-input-wrapper
          i.fas.fa-search.search-icon
          input#uploadLogSearch.search-input(type="search" placeholder="Search by transaction ID" autocomplete="off")
        button.btn-kibana(type="submit")
          i.fas.fa-search.me-2
          | Search
        button.btn-kibana-secondary#clearUploadLogSearch(type="button" hidden)
          i.fas.fa-times.me-2
          | Clear
      .results-header
        .results-count#uploadLogResultsCount Showing upload transactions
        .results-count
          span.timezone-indicator
            i.fas.fa-clock
            span#uploadLogTimezone
          span.mx-2 |
          span Updated:
          strong#uploadLogLastUpdated.ms-1 —
      .logs-table-container#uploadLogs
        .iu-log-empty Select the Logs tab to load recent transactions.

  script.
    (function () {
      var input = document.getElementById('images');
      var dropzone = document.getElementById('dropzone');
      var fileList = document.getElementById('fileList');
      var form = document.getElementById('imageUploadForm');
      var uploadButton = document.getElementById('uploadButton');
      var clearButton = document.getElementById('clearButton');
      var status = document.getElementById('uploadStatus');
      var results = document.getElementById('results');
      var utilityTab = document.getElementById('utilityTab');
      var logsTab = document.getElementById('logsTab');
      var utilityPanel = document.getElementById('utilityPanel');
      var logsPanel = document.getElementById('logsPanel');
      var uploadLogs = document.getElementById('uploadLogs');
      var uploadLogSearchForm = document.getElementById('uploadLogSearchForm');
      var uploadLogSearch = document.getElementById('uploadLogSearch');
      var clearUploadLogSearch = document.getElementById('clearUploadLogSearch');
      var uploadLogResultsCount = document.getElementById('uploadLogResultsCount');
      var uploadLogLastUpdated = document.getElementById('uploadLogLastUpdated');
      var uploadLogTimezone = document.getElementById('uploadLogTimezone');
      var selectedFiles = [];
      var isUploading = false;
      var MAX_FILES = 100;
      var BATCH_SIZE = 5;
      var CONCURRENT_BATCHES = 2;
      var LOG_ITEMS_PER_PAGE = 20;
      var uploadLogData = [];
      var uploadLogItemPages = {};

      function formatBytes(bytes) {
        if (!bytes) return '0 B';
        var units = ['B', 'KB', 'MB'];
        var index = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), units.length - 1);
        return (bytes / Math.pow(1024, index)).toFixed(index ? 1 : 0) + ' ' + units[index];
      }

      function renderFiles() {
        var totalSize = selectedFiles.reduce(function (sum, file) { return sum + file.size; }, 0);
        fileList.innerHTML = selectedFiles.length ? '<div class="iu-selection-summary"><i class="fas fa-images"></i><strong>' + selectedFiles.length + ' image' + (selectedFiles.length === 1 ? '' : 's') + ' selected</strong><span>' + formatBytes(totalSize) + ' total</span></div>' : '';
        uploadButton.disabled = selectedFiles.length === 0;
        clearButton.disabled = selectedFiles.length === 0;
      }

      function addFiles(files) {
        if (isUploading) return;
        var next = Array.prototype.slice.call(files).filter(function (file) { return file.type.indexOf('image/') === 0; });
        selectedFiles = selectedFiles.concat(next).slice(0, MAX_FILES);
        renderFiles();
      }

      function showStatus(message, ok) {
        status.textContent = message;
        status.className = 'iu-status show ' + (ok ? 'ok' : 'err');
      }

      function escapeHtml(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, function (char) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]; });
      }

      function safeAssetUrl(value) {
        try {
          var url = new URL(String(value || ''));
          return url.protocol === 'https:' || url.protocol === 'http:' ? url.href : '';
        } catch (_) {
          return '';
        }
      }

      function createTransactionId() {
        if (window.crypto && typeof window.crypto.randomUUID === 'function') return window.crypto.randomUUID();
        return 'upload-' + Date.now() + '-' + Math.random().toString(36).slice(2, 14);
      }

      async function finalizeTransaction(transactionId, items) {
        var logItems = items.map(function (item) {
          return {
            unitName: String(item.unitName || '').slice(0, 200),
            assetUrl: String(item.assetUrl || '').slice(0, 2000),
            uploadSuccess: item.uploadSuccess === true,
            ctUpdateSuccess: item.ctUpdateSuccess === true,
            ctUpdateSkipped: item.ctUpdateSkipped === true,
            status: String(item.status || 'failed').slice(0, 60),
            error: String(item.error || '').slice(0, 300)
          };
        });
        var response = await fetch('/utility/image-upload/complete', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ transactionId: transactionId, items: logItems })
        });
        var data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Failed to save transaction log');
        return data;
      }

      function setActiveTab(tabName) {
        var showLogs = tabName === 'logs';
        utilityTab.classList.toggle('active', !showLogs);
        logsTab.classList.toggle('active', showLogs);
        utilityTab.setAttribute('aria-selected', String(!showLogs));
        logsTab.setAttribute('aria-selected', String(showLogs));
        utilityPanel.classList.toggle('active', !showLogs);
        logsPanel.classList.toggle('active', showLogs);
        utilityPanel.hidden = showLogs; 
        logsPanel.hidden = !showLogs;
      }

      function toggleUploadLogRow(index) {
        var row = uploadLogs.querySelector('.log-row[data-upload-log-index="' + index + '"]');
        var detail = uploadLogs.querySelector('.log-details[data-upload-log-detail="' + index + '"]');
        if (!row || !detail) return;
        var isOpening = !detail.classList.contains('show');
        row.classList.toggle('expanded');
        detail.classList.toggle('show');
        row.setAttribute('aria-expanded', String(isOpening));
        if (isOpening) renderUploadLogItems(Number(index));
      }

      function renderUploadLogItems(index) {
        var container = document.getElementById('uploadLogItems-' + index);
        var log = uploadLogData[index] || {};
        var metadata = log.metadata || {};
        var items = Array.isArray(metadata.items) ? metadata.items : [];
        var failedItems = items.filter(function (item) {
          return item.uploadSuccess !== true || (item.ctUpdateSuccess !== true && item.ctUpdateSkipped !== true);
        });
        if (!container) return;
        if (!failedItems.length) {
          container.innerHTML = '<div class="iu-log-empty"><i class="fas fa-check-circle me-2" aria-hidden="true"></i>No failed images in this transaction.</div>';
          return;
        }
        var pageCount = Math.ceil(failedItems.length / LOG_ITEMS_PER_PAGE);
        var page = Math.min(Math.max(uploadLogItemPages[index] || 1, 1), pageCount);
        uploadLogItemPages[index] = page;
        var start = (page - 1) * LOG_ITEMS_PER_PAGE;
        var rows = failedItems.slice(start, start + LOG_ITEMS_PER_PAGE).map(function (item) {
          var url = safeAssetUrl(item.assetUrl);
          var link = url ? '<a href="' + escapeHtml(url) + '" target="_blank" rel="noreferrer">Open asset</a>' : '';
          return '<tr><td>' + escapeHtml(item.unitName) + '</td><td>' + link + '</td><td>' + (item.uploadSuccess ? 'Success' : 'Failure') + '</td><td>' + (item.ctUpdateSuccess ? 'Success' : 'Failure') + '</td><td>' + escapeHtml(item.error) + '</td></tr>';
        }).join('');
        container.innerHTML = '<table><thead><tr><th>Unit</th><th>Asset URL</th><th>Upload</th><th>CT update</th><th>Error</th></tr></thead><tbody>' + rows + '</tbody></table><div class="pagination-bar"><div class="page-info">Showing ' + (start + 1) + '–' + Math.min(start + LOG_ITEMS_PER_PAGE, failedItems.length) + ' of ' + failedItems.length + ' failed images</div><div class="page-buttons"><button class="page-btn" type="button" data-upload-log-page="previous" aria-label="Previous failed images"' + (page === 1 ? ' disabled' : '') + '><i class="fas fa-chevron-left" aria-hidden="true"></i></button><span class="page-info">Page ' + page + ' of ' + pageCount + '</span><button class="page-btn" type="button" data-upload-log-page="next" aria-label="Next failed images"' + (page === pageCount ? ' disabled' : '') + '><i class="fas fa-chevron-right" aria-hidden="true"></i></button></div></div>';
        container.querySelectorAll('[data-upload-log-page]').forEach(function (button) {
          button.addEventListener('click', function () {
            uploadLogItemPages[index] += button.getAttribute('data-upload-log-page') === 'next' ? 1 : -1;
            renderUploadLogItems(index);
          });
        });
      }

      function renderUploadLogs(logs, totalCount, search) {
        uploadLogData = logs;
        uploadLogItemPages = {};
        uploadLogResultsCount.innerHTML = search ? 'Found <strong>' + totalCount + '</strong> result' + (totalCount === 1 ? '' : 's') + ' for “' + escapeHtml(search) + '”' : 'Showing <strong>' + logs.length + '</strong> upload transaction' + (logs.length === 1 ? '' : 's');
        uploadLogLastUpdated.textContent = new Date().toLocaleTimeString();
        if (!logs.length) {
          uploadLogs.innerHTML = '<div class="iu-log-empty">No image upload transactions found.</div>';
          return;
        }
        var body = logs.map(function (log, index) {
          var metadata = log.metadata || {};
          var timestamp = log.timestamp ? new Date(log.timestamp).toLocaleString() : '';
          var statusLabel = metadata.success ? 'SUCCESS' : 'FAILED';
          var statusClass = metadata.success ? 'log-level-info' : 'log-level-error';
          return '<tr class="log-row" data-upload-log-index="' + index + '" tabindex="0" role="button" aria-expanded="false" aria-controls="uploadLogDetail-' + index + '"><td class="expand-icon"><i class="fas fa-chevron-right" aria-hidden="true"></i></td><td>' + escapeHtml(timestamp) + '</td><td><span class="log-level ' + statusClass + '">' + statusLabel + '</span></td><td>' + escapeHtml(metadata.successfulUploads || 0) + ' / ' + escapeHtml(metadata.totalImages || 0) + '</td><td>' + escapeHtml(metadata.successfulCtUpdates || 0) + ' / ' + escapeHtml(metadata.totalImages || 0) + '</td><td class="iu-log-id" title="' + escapeHtml(metadata.transactionId) + '">' + escapeHtml(metadata.transactionId) + '</td><td>' + escapeHtml(metadata.totalImages) + '</td></tr><tr class="log-details" id="uploadLogDetail-' + index + '" data-upload-log-detail="' + index + '"><td colspan="7"><div class="log-details-content"><div class="iu-log-summary"><div class="iu-log-summary-item"><span class="iu-log-summary-label">User</span><span class="iu-log-summary-value" title="' + escapeHtml(metadata.username) + '">' + escapeHtml(metadata.username) + '</span></div><div class="iu-log-summary-item"><span class="iu-log-summary-label">Uploaded</span><span class="iu-log-summary-value">' + escapeHtml(metadata.successfulUploads) + ' / ' + escapeHtml(metadata.totalImages) + '</span></div><div class="iu-log-summary-item"><span class="iu-log-summary-label">CT updated</span><span class="iu-log-summary-value">' + escapeHtml(metadata.successfulCtUpdates) + ' / ' + escapeHtml(metadata.totalImages) + '</span></div><div class="iu-log-summary-item"><span class="iu-log-summary-label">CT skipped</span><span class="iu-log-summary-value">' + escapeHtml(metadata.skippedCtUpdates || 0) + '</span></div></div><div class="iu-log-items" id="uploadLogItems-' + index + '"></div></div></td></tr>';
        }).join('');
        uploadLogs.innerHTML = '<table class="log-table"><thead><tr><th style="width:30px"></th><th>Timestamp</th><th>Status</th><th>Uploaded in CF</th><th>Updated in CT</th><th>Transaction ID</th><th>Images</th></tr></thead><tbody>' + body + '</tbody></table>';
        uploadLogs.querySelectorAll('.log-row[data-upload-log-index]').forEach(function (row) {
          row.addEventListener('click', function () { toggleUploadLogRow(row.getAttribute('data-upload-log-index')); });
          row.addEventListener('keydown', function (event) {
            if (event.key !== 'Enter' && event.key !== ' ') return;
            event.preventDefault();
            toggleUploadLogRow(row.getAttribute('data-upload-log-index'));
          });
        });
      }

      async function loadUploadLogs(search) {
        uploadLogs.innerHTML = '<div class="iu-log-empty"><i class="fas fa-circle-notch fa-spin me-2"></i>Loading transactions…</div>';
        try {
          var params = new URLSearchParams({ limit: '50' });
          if (search) params.set('search', search);
          var response = await fetch('/logs/image-upload-transactions?' + params.toString(), { credentials: 'same-origin', headers: { Accept: 'application/json' } });
          var data = await response.json();
          if (!response.ok) throw new Error(data.error || 'Failed to load logs');
          clearUploadLogSearch.hidden = !search;
          renderUploadLogs(data.logs || [], data.totalCount || 0, data.search || '');
        } catch (error) {
          uploadLogs.innerHTML = '<div class="iu-log-empty">' + escapeHtml(error.message || 'Failed to load logs') + '</div>';
        }
      }

      function csvEscape(value) {
        var text = String(value == null ? '' : value);
        return /[",\n\r]/.test(text) ? '"' + text.replace(/"/g, '""') + '"' : text;
      }

      function createCsv(items) {
        var rows = [['Unit Name', 'Contentful Asset URL', 'Product ID', 'Project Name', 'Building Code', 'Floor Number', 'Status', 'Error']];
        items.forEach(function (item) {
          rows.push([item.unitName, item.assetUrl, item.productId, item.projectName, item.buildingCode, item.floorNumber, item.status, item.error]);
        });
        return rows.map(function (row) { return row.map(csvEscape).join(','); }).join('\n');
      }

      function unitFromFilename(filename) {
        return filename.replace(/\.[^/.]+$/, '').trim().replace(/_+/g, '/');
      }

      function failedBatchResults(batch, message) {
        return batch.map(function (file) {
          return { unitName: unitFromFilename(file.name), assetUrl: '', productId: '', projectName: '', buildingCode: '', floorNumber: '', status: 'failed', error: message };
        });
      }

      async function uploadBatch(batch) {
        var body = new FormData();
        batch.forEach(function (file) { body.append('images', file); });
        var response = await fetch('/utility/image-upload/upload', { method: 'POST', body: body, credentials: 'same-origin' });
        var data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Batch upload failed');
        return data.results;
      }

      function renderResults(data) {
        results.innerHTML = '<div class="iu-card"><div class="iu-actions" style="margin-top:0"><button class="iu-button" type="button" id="downloadCsv"><i class="fas fa-download me-2"></i>Download CSV</button></div><div class="iu-results"><table><thead><tr><th>Unit</th><th>Asset URL</th><th>Product</th><th>Project</th><th>Building</th><th>Floor</th><th>Status</th><th>Details</th></tr></thead><tbody>' + data.results.map(function (item) {
          var link = item.assetUrl ? '<a href="' + escapeHtml(item.assetUrl) + '" target="_blank" rel="noreferrer">Open asset</a>' : '';
          return '<tr><td>' + escapeHtml(item.unitName) + '</td><td>' + link + '</td><td>' + escapeHtml(item.productId) + '</td><td>' + escapeHtml(item.projectName) + '</td><td>' + escapeHtml(item.buildingCode) + '</td><td>' + escapeHtml(item.floorNumber) + '</td><td><span class="iu-badge ' + escapeHtml(item.status) + '">' + escapeHtml(item.status) + '</span></td><td>' + escapeHtml(item.error) + '</td></tr>';
        }).join('') + '</tbody></table></div></div>';
        document.getElementById('downloadCsv').addEventListener('click', function () {
          var blob = new Blob([data.csv], { type: 'text/csv;charset=utf-8' });
          var url = URL.createObjectURL(blob);
          var anchor = document.createElement('a');
          anchor.href = url;
          anchor.download = 'contentful-image-assets.csv';
          anchor.click();
          URL.revokeObjectURL(url);
        });
      }

      input.addEventListener('change', function () { selectedFiles = []; addFiles(input.files); });
      utilityTab.addEventListener('click', function () { setActiveTab('utility'); });
      logsTab.addEventListener('click', function () { setActiveTab('logs'); loadUploadLogs(); });
      uploadLogSearchForm.addEventListener('submit', function (event) {
        event.preventDefault();
        loadUploadLogs(uploadLogSearch.value.trim());
      });
      clearUploadLogSearch.addEventListener('click', function () {
        uploadLogSearch.value = '';
        loadUploadLogs('');
        uploadLogSearch.focus();
      });
      uploadLogTimezone.textContent = Intl.DateTimeFormat().resolvedOptions().timeZone;
      clearButton.addEventListener('click', function () { selectedFiles = []; input.value = ''; results.innerHTML = ''; status.className = 'iu-status'; renderFiles(); });
      ['dragenter', 'dragover'].forEach(function (eventName) { dropzone.addEventListener(eventName, function (event) { event.preventDefault(); dropzone.classList.add('dragover'); }); });
      ['dragleave', 'drop'].forEach(function (eventName) { dropzone.addEventListener(eventName, function (event) { event.preventDefault(); dropzone.classList.remove('dragover'); }); });
      dropzone.addEventListener('drop', function (event) { addFiles(event.dataTransfer.files); });
      form.addEventListener('submit', async function (event) {
        event.preventDefault();
        if (!selectedFiles.length || isUploading) return;
        var transactionId = createTransactionId();
        isUploading = true;
        input.disabled = true;
        uploadButton.disabled = true;
        clearButton.disabled = true;
        uploadButton.innerHTML = '<i class="fas fa-circle-notch fa-spin me-2"></i>Processing...';
        results.innerHTML = '';

        var batches = [];
        for (var offset = 0; offset < selectedFiles.length; offset += BATCH_SIZE) {
          batches.push(selectedFiles.slice(offset, offset + BATCH_SIZE));
        }
        var batchResults = new Array(batches.length);
        var nextBatchIndex = 0;
        var completedBatches = 0;
        var processedFiles = 0;

        function updateProgress() {
          showStatus('Processed ' + processedFiles + ' of ' + selectedFiles.length + ' images · batch ' + completedBatches + ' of ' + batches.length, true);
        }

        async function worker() {
          while (nextBatchIndex < batches.length) {
            var batchIndex = nextBatchIndex++;
            var batch = batches[batchIndex];
            try {
              batchResults[batchIndex] = await uploadBatch(batch);
            } catch (error) {
              batchResults[batchIndex] = failedBatchResults(batch, error.message || 'Batch upload failed');
            }
            processedFiles += batch.length;
            completedBatches += 1;
            updateProgress();
          }
        }

        updateProgress();
        try {
          var workers = [];
          var workerCount = Math.min(CONCURRENT_BATCHES, batches.length);
          for (var index = 0; index < workerCount; index += 1) workers.push(worker());
          await Promise.all(workers);

          var allResults = batchResults.reduce(function (all, batch) { return all.concat(batch || []); }, []);
          var failedCount = allResults.filter(function (item) { return item.status === 'failed'; }).length;
          renderResults({ results: allResults, csv: createCsv(allResults) });
          try {
            await finalizeTransaction(transactionId, allResults);
            showStatus('Finished: ' + (allResults.length - failedCount) + ' completed, ' + failedCount + ' failed. Transaction ' + transactionId + ' was logged.', failedCount === 0);
          } catch (logError) {
            showStatus('Uploads finished, but the transaction log could not be saved: ' + (logError.message || 'Unknown logging error'), false);
          }
        } catch (error) {
          showStatus(error.message || 'Upload failed', false);
        } finally {
          isUploading = false;
          input.disabled = false;
          uploadButton.disabled = selectedFiles.length === 0;
          clearButton.disabled = selectedFiles.length === 0;
          uploadButton.innerHTML = '<i class="fas fa-upload me-2"></i>Start upload';
        }
      });
    }());
