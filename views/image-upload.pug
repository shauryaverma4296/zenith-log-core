extends layout

block content
  style.
    .cf-header { background: var(--kibana-header); border-bottom: 1px solid var(--kibana-border); padding: 0 16px; height: 48px; display: flex; align-items: center; justify-content: space-between; }
    .cf-header .brand { display: flex; align-items: center; gap: 10px; font-weight: 600; }
    .cf-header .brand i { color: var(--kibana-accent); }
    .cf-header .actions { display: flex; align-items: center; gap: 8px; }
    .cf-back, .cf-logout { background: transparent; border: 1px solid var(--kibana-border); color: var(--kibana-text); padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 12px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .cf-back:hover, .cf-logout:hover { border-color: var(--kibana-accent); color: var(--kibana-accent); }
    .iu-wrap { max-width: 1040px; margin: 0 auto; padding: 40px 24px 64px; }
    .iu-eyebrow { color: var(--kibana-accent); font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; margin: 0 0 8px; }
    .iu-title { font-size: 28px; font-weight: 700; margin: 0 0 8px; }
    .iu-subtitle { color: var(--kibana-text-muted); margin: 0 0 28px; max-width: 720px; line-height: 1.6; }
    .iu-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 20px; align-items: start; }
    .iu-card { background: var(--kibana-sidebar); border: 1px solid var(--kibana-border); border-radius: 10px; padding: 24px; }
    .iu-card-title { font-size: 14px; font-weight: 700; margin: 0 0 6px; }
    .iu-help { color: var(--kibana-text-muted); font-size: 12px; line-height: 1.6; margin: 0 0 18px; }
    .iu-dropzone { border: 1px dashed var(--kibana-text-muted); border-radius: 8px; padding: 34px 20px; text-align: center; cursor: pointer; transition: border-color .2s, background .2s; }
    .iu-dropzone:hover, .iu-dropzone.dragover { border-color: var(--kibana-accent); background: rgba(54,162,239,.08); }
    .iu-dropzone i { color: var(--kibana-accent); font-size: 28px; margin-bottom: 12px; }
    .iu-dropzone strong { display: block; font-size: 14px; margin-bottom: 6px; }
    .iu-dropzone span { color: var(--kibana-text-muted); font-size: 12px; }
    .iu-file-input { display: none; }
    .iu-file-list { display: grid; gap: 8px; margin: 18px 0 0; }
    .iu-file { align-items: center; background: var(--kibana-bg); border: 1px solid var(--kibana-border); border-radius: 6px; display: flex; gap: 10px; justify-content: space-between; padding: 10px 12px; }
    .iu-file-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .iu-file-size { color: var(--kibana-text-muted); flex: 0 0 auto; font-family: 'JetBrains Mono', monospace; font-size: 11px; }
    .iu-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 20px; }
    .iu-button { background: var(--kibana-accent); border: 0; border-radius: 6px; color: #fff; cursor: pointer; font-size: 13px; font-weight: 600; padding: 10px 16px; }
    .iu-button:disabled { cursor: not-allowed; opacity: .55; }
    .iu-button.secondary { background: transparent; border: 1px solid var(--kibana-border); color: var(--kibana-text); }
    .iu-steps { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
    .iu-step { align-items: flex-start; color: var(--kibana-text-muted); display: flex; font-size: 12px; gap: 10px; line-height: 1.4; }
    .iu-step i { color: var(--kibana-accent); margin-top: 2px; width: 14px; }
    .iu-status { border-radius: 6px; display: none; font-size: 12px; line-height: 1.5; margin-top: 16px; padding: 10px 12px; }
    .iu-status.show { display: block; }
    .iu-status.ok { background: rgba(125,226,209,.12); border: 1px solid rgba(125,226,209,.3); color: var(--kibana-success); }
    .iu-status.err { background: rgba(255,107,107,.12); border: 1px solid rgba(255,107,107,.3); color: var(--kibana-error); }
    .iu-results { margin-top: 20px; overflow-x: auto; }
    .iu-results > .iu-card { padding: 0; border: 0; }
    .iu-results table { border-collapse: collapse; min-width: 760px; width: 100%; }
    .iu-results th, .iu-results td { border-bottom: 1px solid var(--kibana-border); padding: 10px; text-align: left; vertical-align: top; }
    .iu-results th { color: var(--kibana-text-muted); font-size: 10px; text-transform: uppercase; }
    .iu-results td { font-size: 12px; }
    .iu-results a { color: var(--kibana-accent); }
    .iu-badge { border-radius: 4px; display: inline-block; font-size: 10px; padding: 3px 6px; text-transform: uppercase; }
    .iu-badge.uploaded { background: rgba(125,226,209,.14); color: var(--kibana-success); }
    .iu-badge.duplicate-skipped { background: rgba(245,166,35,.14); color: var(--kibana-warning); }
    .iu-badge.failed { background: rgba(255,107,107,.14); color: var(--kibana-error); }
    @media (max-width: 760px) { .iu-grid { grid-template-columns: 1fr; } .iu-wrap { padding: 28px 16px 48px; } }

  .cf-header
    .brand
      i.fas.fa-images
      span Image Upload Utility
    .actions
      a.cf-back(href="/select")
        i.fas.fa-arrow-left
        span Back
      form(method="POST" action="/auth/logout" style="display:inline;")
        button.cf-logout(type="submit")
          i.fas.fa-sign-out-alt
          span Logout

  .iu-wrap
    p.iu-eyebrow Image pipeline
    h1.iu-title Bulk image upload
    p.iu-subtitle Upload unit images, look up matching product details, publish each image to Contentful, and download the resulting asset URLs as a CSV file.

    .iu-grid
      .iu-card
        h2.iu-card-title Choose images
        p.iu-help Unit names are read from the filename without its extension, and underscores are converted to slashes. For example, #[code CHLB_17_1701.jpg] looks up unit #[code CHLB/17/1701]. Upload up to 10 images, each up to 20 MB.
        form#imageUploadForm(enctype="multipart/form-data")
          label.iu-dropzone#dropzone(for="images")
            i.fas.fa-cloud-upload-alt
            strong Drop images here or choose files
            span JPG, PNG, WEBP, GIF, or other image files
          input.iu-file-input#images(type="file" name="images" accept="image/*" multiple)
          .iu-file-list#fileList
          .iu-actions
            button.iu-button.secondary#clearButton(type="button" disabled) Clear
            button.iu-button#uploadButton(type="submit" disabled)
              i.fas.fa-upload.me-2
              | Start upload
          #uploadStatus.iu-status
        #results

      .iu-card
        h2.iu-card-title Workflow
        p.iu-help Each image follows the same server-side sequence.
        ul.iu-steps
          li.iu-step
            i.fas.fa-key
            span Authenticate with Commercetools
          li.iu-step
            i.fas.fa-search
            span Find the product using the unit name
          li.iu-step
            i.fas.fa-tags
            span Validate or create Contentful tags
          li.iu-step
            i.fas.fa-copy
            span Skip matching assets already published
          li.iu-step
            i.fas.fa-cloud-upload-alt
            span Upload, process, and publish the asset
          li.iu-step
            i.fas.fa-file-csv
            span Download unit names and asset URLs

  script.
    (function () {
      var input = document.getElementById('images');
      var dropzone = document.getElementById('dropzone');
      var fileList = document.getElementById('fileList');
      var form = document.getElementById('imageUploadForm');
      var uploadButton = document.getElementById('uploadButton');
      var clearButton = document.getElementById('clearButton');
      var status = document.getElementById('uploadStatus');
      var results = document.getElementById('results');
      var selectedFiles = [];

      function formatBytes(bytes) {
        if (!bytes) return '0 B';
        var units = ['B', 'KB', 'MB'];
        var index = Math.min(Math.floor(Math.log(bytes) / Math.log(1024)), units.length - 1);
        return (bytes / Math.pow(1024, index)).toFixed(index ? 1 : 0) + ' ' + units[index];
      }

      function renderFiles() {
        fileList.innerHTML = selectedFiles.map(function (file) {
          return '<div class="iu-file"><span class="iu-file-name"><i class="fas fa-image me-2"></i>' + file.name.replace(/[<>&"]/g, '') + '</span><span class="iu-file-size">' + formatBytes(file.size) + '</span></div>';
        }).join('');
        uploadButton.disabled = selectedFiles.length === 0;
        clearButton.disabled = selectedFiles.length === 0;
      }

      function addFiles(files) {
        var next = Array.prototype.slice.call(files).filter(function (file) { return file.type.indexOf('image/') === 0; });
        selectedFiles = selectedFiles.concat(next).slice(0, 10);
        renderFiles();
      }

      function showStatus(message, ok) {
        status.textContent = message;
        status.className = 'iu-status show ' + (ok ? 'ok' : 'err');
      }

      function escapeHtml(value) {
        return String(value == null ? '' : value).replace(/[&<>"']/g, function (char) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]; });
      }

      function renderResults(data) {
        results.innerHTML = '<div class="iu-card"><div class="iu-actions" style="margin-top:0"><button class="iu-button" type="button" id="downloadCsv"><i class="fas fa-download me-2"></i>Download CSV</button></div><div class="iu-results"><table><thead><tr><th>Unit</th><th>Asset URL</th><th>Product</th><th>Project</th><th>Building</th><th>Floor</th><th>Status</th><th>Details</th></tr></thead><tbody>' + data.results.map(function (item) {
          var link = item.assetUrl ? '<a href="' + escapeHtml(item.assetUrl) + '" target="_blank" rel="noreferrer">Open asset</a>' : '';
          return '<tr><td>' + escapeHtml(item.unitName) + '</td><td>' + link + '</td><td>' + escapeHtml(item.productId) + '</td><td>' + escapeHtml(item.projectName) + '</td><td>' + escapeHtml(item.buildingCode) + '</td><td>' + escapeHtml(item.floorNumber) + '</td><td><span class="iu-badge ' + escapeHtml(item.status) + '">' + escapeHtml(item.status) + '</span></td><td>' + escapeHtml(item.error) + '</td></tr>';
        }).join('') + '</tbody></table></div></div>';
        document.getElementById('downloadCsv').addEventListener('click', function () {
          var blob = new Blob([data.csv], { type: 'text/csv;charset=utf-8' });
          var url = URL.createObjectURL(blob);
          var anchor = document.createElement('a');
          anchor.href = url;
          anchor.download = 'contentful-image-assets.csv';
          anchor.click();
          URL.revokeObjectURL(url);
        });
      }

      input.addEventListener('change', function () { selectedFiles = []; addFiles(input.files); });
      clearButton.addEventListener('click', function () { selectedFiles = []; input.value = ''; results.innerHTML = ''; status.className = 'iu-status'; renderFiles(); });
      ['dragenter', 'dragover'].forEach(function (eventName) { dropzone.addEventListener(eventName, function (event) { event.preventDefault(); dropzone.classList.add('dragover'); }); });
      ['dragleave', 'drop'].forEach(function (eventName) { dropzone.addEventListener(eventName, function (event) { event.preventDefault(); dropzone.classList.remove('dragover'); }); });
      dropzone.addEventListener('drop', function (event) { addFiles(event.dataTransfer.files); });
      form.addEventListener('submit', async function (event) {
        event.preventDefault();
        var body = new FormData();
        selectedFiles.forEach(function (file) { body.append('images', file); });
        uploadButton.disabled = true;
        clearButton.disabled = true;
        uploadButton.innerHTML = '<i class="fas fa-circle-notch fa-spin me-2"></i>Processing...';
        showStatus('Processing images through the upload workflow…', true);
        try {
          var response = await fetch('/utility/image-upload/upload', { method: 'POST', body: body, credentials: 'same-origin' });
          var data = await response.json();
          if (!response.ok) throw new Error(data.error || 'Upload failed');
          renderResults(data);
          showStatus('Finished: ' + data.results.filter(function (item) { return item.status !== 'failed'; }).length + ' image(s) completed.', true);
        } catch (error) {
          showStatus(error.message || 'Upload failed', false);
        } finally {
          uploadButton.disabled = selectedFiles.length === 0;
          clearButton.disabled = selectedFiles.length === 0;
          uploadButton.innerHTML = '<i class="fas fa-upload me-2"></i>Start upload';
        }
      });
    }());
