doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title || "Logger Dashboard"
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet")
    link(href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet")
    link(href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet")
    style.
      :root {
        --kibana-bg: #1d1e24;
        --kibana-sidebar: #25262e;
        --kibana-header: #343741;
        --kibana-border: #343741;
        --kibana-text: #dfe5ef;
        --kibana-text-muted: #98a2b3;
        --kibana-accent: #36a2ef;
        --kibana-success: #7de2d1;
        --kibana-warning: #f5a623;
        --kibana-error: #ff6b6b;
        --kibana-info: #36a2ef;
        --kibana-debug: #98a2b3;
        --kibana-row-hover: #2c2d33;
        --kibana-expanded: #1a1b20;
      }
      * { box-sizing: border-box; }
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        background: var(--kibana-bg);
        color: var(--kibana-text);
        min-height: 100vh;
        margin: 0;
        font-size: 13px;
      }
      .kibana-header {
        background: var(--kibana-header);
        border-bottom: 1px solid var(--kibana-border);
        padding: 0 16px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 100;
      }
      .kibana-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
        font-size: 15px;
        color: var(--kibana-text);
      }
      .kibana-logo i {
        color: var(--kibana-accent);
        font-size: 18px;
      }
      .kibana-main {
        display: flex;
        min-height: calc(100vh - 48px);
      }
      .kibana-sidebar {
        width: 260px;
        background: var(--kibana-sidebar);
        border-right: 1px solid var(--kibana-border);
        padding: 16px;
        flex-shrink: 0;
      }
      .kibana-content {
        flex: 1;
        padding: 0;
        overflow-x: auto;
      }
      .search-bar {
        background: var(--kibana-sidebar);
        border-bottom: 1px solid var(--kibana-border);
        padding: 12px 16px;
        display: flex;
        gap: 12px;
        align-items: center;
      }
      .search-input-wrapper {
        flex: 1;
        position: relative;
      }
      .search-input {
        width: 100%;
        background: var(--kibana-bg);
        border: 1px solid var(--kibana-border);
        border-radius: 6px;
        padding: 8px 12px 8px 36px;
        color: var(--kibana-text);
        font-size: 13px;
        outline: none;
        transition: border-color 0.2s;
      }
      .search-input:focus {
        border-color: var(--kibana-accent);
      }
      .search-input::placeholder {
        color: var(--kibana-text-muted);
      }
      .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--kibana-text-muted);
        font-size: 12px;
      }
      .filter-pills {
        display: flex;
        gap: 8px;
      }
      .filter-pill {
        background: var(--kibana-bg);
        border: 1px solid var(--kibana-border);
        border-radius: 16px;
        padding: 6px 14px;
        font-size: 12px;
        color: var(--kibana-text-muted);
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .filter-pill:hover {
        border-color: var(--kibana-accent);
        color: var(--kibana-text);
      }
      .filter-pill.active {
        background: rgba(54, 162, 239, 0.15);
        border-color: var(--kibana-accent);
        color: var(--kibana-accent);
      }
      .btn-kibana {
        background: var(--kibana-accent);
        border: none;
        border-radius: 6px;
        padding: 8px 16px;
        color: #fff;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
      }
      .btn-kibana:hover {
        background: #2891de;
      }
      .btn-kibana-secondary {
        background: transparent;
        border: 1px solid var(--kibana-border);
        border-radius: 6px;
        padding: 8px 16px;
        color: var(--kibana-text);
        font-size: 13px;
        cursor: pointer;
        transition: all 0.2s;
      }
      .btn-kibana-secondary:hover {
        border-color: var(--kibana-text-muted);
        background: var(--kibana-row-hover);
      }
      .results-header {
        background: var(--kibana-sidebar);
        border-bottom: 1px solid var(--kibana-border);
        padding: 8px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12px;
        color: var(--kibana-text-muted);
      }
      .results-count {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .results-count strong {
        color: var(--kibana-text);
      }
      .log-table {
        width: 100%;
        border-collapse: collapse;
      }
      .log-table th {
        background: var(--kibana-header);
        padding: 10px 12px;
        text-align: left;
        font-weight: 600;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--kibana-text-muted);
        border-bottom: 1px solid var(--kibana-border);
        position: sticky;
        top: 0;
        white-space: nowrap;
      }
      .log-row {
        border-bottom: 1px solid var(--kibana-border);
        cursor: pointer;
        transition: background 0.15s;
      }
      .log-row:hover {
        background: var(--kibana-row-hover);
      }
      .log-row.expanded {
        background: var(--kibana-expanded);
      }
      .log-row td {
        padding: 8px 12px;
        vertical-align: top;
        font-size: 12px;
      }
      .expand-icon {
        width: 20px;
        text-align: center;
        color: var(--kibana-text-muted);
        transition: transform 0.2s;
      }
      .log-row.expanded .expand-icon {
        transform: rotate(90deg);
      }
      .log-timestamp {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        color: var(--kibana-text-muted);
        white-space: nowrap;
      }
      .log-level {
        font-weight: 600;
        font-size: 11px;
        padding: 2px 8px;
        border-radius: 3px;
        text-transform: uppercase;
        display: inline-block;
      }
      .log-level-error {
        background: rgba(255, 107, 107, 0.2);
        color: var(--kibana-error);
      }
      .log-level-warn {
        background: rgba(245, 166, 35, 0.2);
        color: var(--kibana-warning);
      }
      .log-level-info {
        background: rgba(54, 162, 239, 0.2);
        color: var(--kibana-info);
      }
      .log-level-debug {
        background: rgba(152, 162, 179, 0.2);
        color: var(--kibana-debug);
      }
      .log-message {
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        word-break: break-word;
      }
      .log-id {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        color: var(--kibana-accent);
        max-width: 150px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      .log-details {
        display: none;
        background: var(--kibana-bg);
        border-top: 1px solid var(--kibana-border);
        padding: 0;
      }
      .log-details.show {
        display: table-row;
      }
      .log-details td {
        padding: 0;
      }
      .log-details-content {
        padding: 16px;
      }
      .detail-tabs {
        display: flex;
        gap: 0;
        border-bottom: 1px solid var(--kibana-border);
        margin-bottom: 16px;
      }
      .detail-tab {
        padding: 10px 20px;
        color: var(--kibana-text-muted);
        cursor: pointer;
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
        font-size: 13px;
        transition: all 0.2s;
      }
      .detail-tab:hover {
        color: var(--kibana-text);
      }
      .detail-tab.active {
        color: var(--kibana-accent);
        border-bottom-color: var(--kibana-accent);
      }
      .json-viewer {
        background: #0d1117;
        border-radius: 6px;
        padding: 16px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        line-height: 1.6;
        overflow-x: auto;
        color: #c9d1d9;
        max-height: 400px;
        overflow-y: auto;
        white-space: pre;
        word-wrap: normal;
      }
      .json-viewer code {
        white-space: pre;
        word-wrap: normal;
        display: block;
      }
      .json-key { color: #7ee787; }
      .json-string { color: #a5d6ff; word-break: break-all; }
      .json-number { color: #79c0ff; }
      .json-boolean { color: #ff7b72; }
      .json-null { color: #8b949e; }
      .json-panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
        font-size: 13px;
        font-weight: 600;
        color: var(--kibana-text);
      }
      .copy-btn {
        background: var(--kibana-bg);
        border: 1px solid var(--kibana-border);
        border-radius: 4px;
        padding: 6px 12px;
        color: var(--kibana-text-muted);
        font-size: 11px;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .copy-btn:hover {
        border-color: var(--kibana-accent);
        color: var(--kibana-accent);
      }
      .copy-toast {
        position: fixed;
        bottom: 80px;
        right: 20px;
        background: var(--kibana-success);
        color: #1d1e24;
        padding: 12px 20px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 500;
        font-size: 13px;
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.3s;
        z-index: 1000;
      }
      .copy-toast.show {
        opacity: 1;
        transform: translateY(0);
      }
      .field-row {
        display: flex;
        padding: 8px 0;
        border-bottom: 1px solid var(--kibana-border);
      }
      .field-row:last-child {
        border-bottom: none;
      }
      .field-name {
        width: 180px;
        color: var(--kibana-text-muted);
        flex-shrink: 0;
        font-size: 12px;
      }
      .field-value {
        flex: 1;
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        word-break: break-all;
      }
      .detail-tab i {
        margin-right: 6px;
      }
      .logs-table-container {
        flex: 1;
        overflow-y: auto;
        max-height: calc(100vh - 200px);
      }
      .pagination-fixed {
        position: sticky;
        bottom: 0;
        background: var(--kibana-sidebar);
        border-top: 1px solid var(--kibana-border);
        z-index: 10;
      }
      .sidebar-section {
        margin-bottom: 24px;
      }
      .sidebar-title {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--kibana-text-muted);
        margin-bottom: 12px;
      }
      .sidebar-item {
        display: flex;
        align-items: center;
        padding: 8px 12px;
        margin: 2px 0;
        border-radius: 6px;
        color: var(--kibana-text);
        cursor: pointer;
        transition: background 0.15s;
      }
      .sidebar-item:hover {
        background: var(--kibana-row-hover);
      }
      .sidebar-item.active {
        background: rgba(54, 162, 239, 0.15);
        color: var(--kibana-accent);
      }
      .sidebar-item i {
        width: 20px;
        margin-right: 10px;
        font-size: 14px;
      }
      .pagination-bar {
        background: var(--kibana-sidebar);
        border-top: 1px solid var(--kibana-border);
        padding: 12px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .page-info {
        color: var(--kibana-text-muted);
        font-size: 12px;
      }
      .page-buttons {
        display: flex;
        gap: 4px;
      }
      .page-btn {
        background: var(--kibana-bg);
        border: 1px solid var(--kibana-border);
        border-radius: 4px;
        padding: 6px 12px;
        color: var(--kibana-text);
        font-size: 12px;
        cursor: pointer;
        transition: all 0.15s;
      }
      .page-btn:hover:not(:disabled) {
        border-color: var(--kibana-accent);
        color: var(--kibana-accent);
      }
      .page-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }
      .page-btn.active {
        background: var(--kibana-accent);
        border-color: var(--kibana-accent);
        color: #fff;
      }
      .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: var(--kibana-text-muted);
      }
      .empty-state i {
        font-size: 48px;
        margin-bottom: 16px;
        opacity: 0.3;
      }
      .empty-state h3 {
        font-size: 16px;
        margin-bottom: 8px;
        color: var(--kibana-text);
      }
      .spinner {
        display: inline-block;
        width: 20px;
        height: 20px;
        border: 2px solid var(--kibana-border);
        border-radius: 50%;
        border-top-color: var(--kibana-accent);
        animation: spin 1s linear infinite;
      }
      @keyframes spin {
        to { transform: rotate(360deg); }
      }
      .loading-overlay {
        display: none;
        position: fixed;
        top: 48px;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(29, 30, 36, 0.9);
        z-index: 50;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        gap: 16px;
      }
      .loading-overlay.show {
        display: flex;
      }
      .modal-backdrop-custom {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.7);
        z-index: 1000;
        display: none;
      }
      .modal-backdrop-custom.show {
        display: block;
      }
      .modal-kibana {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: var(--kibana-sidebar);
        border-radius: 8px;
        width: 90%;
        max-width: 800px;
        max-height: 80vh;
        z-index: 1001;
        display: none;
        flex-direction: column;
      }
      .modal-kibana.show {
        display: flex;
      }
      .modal-header-kibana {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
        border-bottom: 1px solid var(--kibana-border);
      }
      .modal-title-kibana {
        font-weight: 600;
        font-size: 16px;
      }
      .modal-close {
        background: none;
        border: none;
        color: var(--kibana-text-muted);
        cursor: pointer;
        font-size: 18px;
        padding: 4px;
      }
      .modal-close:hover {
        color: var(--kibana-text);
      }
      .modal-body-kibana {
        padding: 20px;
        overflow-y: auto;
        flex: 1;
      }
      .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: calc(100vh - 48px);
        padding: 20px;
        background: linear-gradient(135deg, var(--kibana-bg) 0%, #12131a 100%);
      }
      .login-card {
        background: var(--kibana-sidebar);
        border-radius: 12px;
        width: 100%;
        max-width: 400px;
        border: 1px solid var(--kibana-border);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        overflow: hidden;
      }
      .login-header {
        background: linear-gradient(135deg, var(--kibana-accent), #2575fc);
        padding: 32px;
        text-align: center;
      }
      .login-logo {
        width: 60px;
        height: 60px;
        background: rgba(255, 255, 255, 0.15);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        font-size: 28px;
        color: #fff;
      }
      .login-title {
        font-size: 22px;
        font-weight: 700;
        color: #fff;
        margin: 0 0 8px;
      }
      .login-subtitle {
        font-size: 13px;
        color: rgba(255, 255, 255, 0.75);
        margin: 0;
      }
      .login-body {
        padding: 32px;
      }
      .login-alert {
        background: rgba(255, 107, 107, 0.15);
        border: 1px solid var(--kibana-error);
        border-radius: 8px;
        padding: 12px 16px;
        color: var(--kibana-error);
        margin-bottom: 20px;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .login-alert i {
        font-size: 16px;
      }
      .form-group {
        margin-bottom: 20px;
      }
      .form-label {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        font-size: 12px;
        font-weight: 500;
        color: var(--kibana-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }
      .form-label i {
        font-size: 11px;
      }
      .login-input {
        width: 100%;
        background: var(--kibana-bg);
        border: 1px solid var(--kibana-border);
        border-radius: 8px;
        padding: 12px 16px;
        color: var(--kibana-text);
        font-size: 14px;
        outline: none;
        transition: all 0.2s;
      }
      .login-input:focus {
        border-color: var(--kibana-accent);
        box-shadow: 0 0 0 3px rgba(54, 162, 239, 0.15);
      }
      .login-input::placeholder {
        color: var(--kibana-text-muted);
      }
      .remember-group {
        margin-bottom: 24px;
      }
      .remember-checkbox {
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        font-size: 13px;
        color: var(--kibana-text-muted);
      }
      .remember-checkbox input[type="checkbox"] {
        width: 18px;
        height: 18px;
        accent-color: var(--kibana-accent);
        cursor: pointer;
      }
      .login-btn {
        width: 100%;
        background: linear-gradient(135deg, var(--kibana-accent), #2575fc);
        border: none;
        border-radius: 8px;
        padding: 14px;
        color: #fff;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
      }
      .login-btn:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(54, 162, 239, 0.3);
      }
      .login-btn:disabled {
        opacity: 0.7;
        cursor: not-allowed;
      }
      .login-btn.success {
        background: linear-gradient(135deg, var(--kibana-success), #4CAF50);
      }
      .login-spinner {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .login-footer {
        padding: 16px 32px;
        border-top: 1px solid var(--kibana-border);
        text-align: center;
        font-size: 12px;
        color: var(--kibana-text-muted);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
      }
      .login-footer i {
        color: var(--kibana-success);
      }
  body
    .kibana-header
      .kibana-logo
        i.fas.fa-layer-group
        span Logs Explorer
      div
        if title && title.includes('Login')
          // Nothing
        else
          form.d-inline(method="POST" action="/auth/logout" style="margin: 0;")
            button.btn-kibana-secondary(type="submit")
              i.fas.fa-sign-out-alt.me-2
              | Logout
    
    block content
    
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js")
