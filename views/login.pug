extends layout

block content
  .login-container
    .login-card
      .login-header
        .login-logo
          i.fas.fa-layer-group
        h1.login-title Logger Dashboard
        p.login-subtitle Secure access to your logs
      
      .login-body
        if error
          .login-alert
            i.fas.fa-exclamation-circle
            span= error
        
        form#loginForm(method="POST" action="/auth/login")
          .form-group
            label.form-label
              i.fas.fa-user
              span Username
            input.login-input(
              type="text"
              id="username"
              name="username"
              required
              placeholder="Enter your username"
              autocomplete="username"
            )
          
          .form-group
            label.form-label
              i.fas.fa-lock
              span Password
            input.login-input(
              type="password"
              id="password"
              name="password"
              required
              placeholder="Enter your password"
              autocomplete="current-password"
            )
          
          .form-group.remember-group
            label.remember-checkbox
              input(type="checkbox" id="rememberMe" name="rememberMe")
              span.checkmark
              span Remember me
          
          button.login-btn(type="submit")
            span#loginText
              i.fas.fa-sign-in-alt
              | Sign In
            span#loginSpinner.login-spinner(style="display: none;")
              i.fas.fa-circle-notch.fa-spin
              | Signing in...
      
      .login-footer
        i.fas.fa-shield-alt
        span Secure encrypted connection

  script.
    document.getElementById('loginForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const loginText = document.getElementById('loginText');
      const loginSpinner = document.getElementById('loginSpinner');
      const submitBtn = e.target.querySelector('button[type="submit"]');
      
      // Show loading state
      loginText.style.display = 'none';
      loginSpinner.style.display = 'flex';
      submitBtn.disabled = true;
      
      try {
        const formData = new FormData(e.target);
        const response = await fetch('/auth/get-token', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            username: formData.get('username'),
            password: formData.get('password')
          })
        });
        
        const result = await response.json();
        
        if (response.ok && result.data) {
          // Store token and redirect
          if (formData.get('rememberMe')) {
            localStorage.setItem('authToken', result.data);
          } else {
            sessionStorage.setItem('authToken', result.data);
          }
          
          // Show success
          loginSpinner.innerHTML = '<i class="fas fa-check"></i> Success!';
          submitBtn.classList.add('success');
          
          setTimeout(() => {
            window.location.href = '/logs';
          }, 800);
        } else {
          throw new Error(result.message || 'Login failed');
        }
      } catch (error) {
        // Show error
        const existingAlert = document.querySelector('.login-alert');
        if (existingAlert) existingAlert.remove();
        
        const alertDiv = document.createElement('div');
        alertDiv.className = 'login-alert';
        alertDiv.innerHTML = '<i class="fas fa-exclamation-circle"></i><span>' + error.message + '</span>';
        
        const form = document.getElementById('loginForm');
        form.insertBefore(alertDiv, form.firstChild);
        
        // Reset button
        submitBtn.disabled = false;
        loginText.style.display = 'flex';
        loginSpinner.style.display = 'none';
      }
    });
