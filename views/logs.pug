extends layout

block content
  .row
    .col-12
      // Page Header
      .d-flex.justify-content-between.align-items-center.mb-4
        div
          h2.page-title
            i.fas.fa-stream.me-2
            | Application Logs
          p.page-subtitle Monitor and search through your application logs
        .stats-badge
          i.fas.fa-database
          span #{logs.length} logs displayed
      
      // Search Section
      .card-section.search-card
        form#searchForm
          .row.align-items-end.g-3
            .col-lg-5
              label.form-label.fw-semibold
                i.fas.fa-search.me-2
                | Search Logs
              .input-group
                input#searchInput.form-control(
                  type="text"
                  placeholder="Enter correlation ID, transaction ID, or unit name..."
                  value=searchQuery || ""
                )
                button.btn.btn-primary(type="submit")
                  i.fas.fa-search.me-1
                  | Search
            .col-lg-5
              label.form-label.fw-semibold
                i.fas.fa-filter.me-2
                | Search By
              .search-toggle
                .btn-group.w-100(role="group")
                  input#correlationToggle.btn-check(
                    type="radio"
                    name="searchType"
                    value="correlationId"
                    checked=searchType === 'correlationId' || !searchType
                  )
                  label.btn.btn-outline-secondary(for="correlationToggle")
                    i.fas.fa-link.me-1
                    | Correlation ID
                  input#transactionToggle.btn-check(
                    type="radio"
                    name="searchType"
                    value="tibicotransactionid"
                    checked=searchType === 'tibicotransactionid'
                  )
                  label.btn.btn-outline-secondary(for="transactionToggle")
                    i.fas.fa-exchange-alt.me-1
                    | Transaction ID
                  input#unitNameToggle.btn-check(
                    type="radio"
                    name="searchType"
                    value="unitName"
                    checked=searchType === 'unitName'
                  )
                  label.btn.btn-outline-secondary(for="unitNameToggle")
                    i.fas.fa-cube.me-1
                    | Unit Name
            .col-lg-2
              if searchQuery
                a.btn.btn-reset.w-100(href="/logs")
                  i.fas.fa-times
                  | Clear Search
      
      // Loader
      #searchLoader.text-center.py-5(style="display: none;")
        .spinner-border.text-primary(role="status")
          span.visually-hidden Loading...
        p.mt-3.text-muted.fw-medium
          i.fas.fa-search.me-2
          | Searching logs...
      
      // Results Summary
      #resultsContainer.mb-3
        if searchQuery
          .alert.alert-info.d-flex.align-items-center
            i.fas.fa-info-circle.me-3.fs-5
            div
              strong Found #{logs.length} result(s)
              |  matching "#{searchQuery}" in 
              strong #{searchType}
        else
          .alert.alert-secondary.d-flex.align-items-center
            i.fas.fa-clock.me-3.fs-5
            div Showing the latest 
              strong #{logs.length}
              |  log entries
      
      // Logs Table
      .table-container
        table.table.table-hover.log-table.mb-0
          thead
            tr
              th
                i.fas.fa-calendar-alt.me-1
                | Timestamp
              th
                i.fas.fa-tag.me-1
                | Level
              th
                i.fas.fa-comment.me-1
                | Message
              th
                i.fas.fa-link.me-1
                | Correlation ID
              th
                i.fas.fa-exchange-alt.me-1
                | Transaction ID
              th
                i.fas.fa-code.me-1
                | Metadata
              th
                i.fas.fa-file-code.me-1
                | Payload
          tbody
            each log in logs
              tr
                td
                  .d-flex.flex-column
                    span.fw-medium= new Date(log.timestamp).toLocaleDateString()
                    small.text-muted= new Date(log.timestamp).toLocaleTimeString()
                td
                  span(class=`log-level-${log.level}`)= log.level.toUpperCase()
                td
                  span.text-truncate(style="max-width: 250px; display: inline-block;")= log.message
                td
                  if log.correlationId
                    code.text-truncate(style="max-width: 120px; display: inline-block;")= log.correlationId
                  else
                    span.text-muted.fst-italic —
                td
                  if log.tibicotransactionid
                    code.text-truncate(style="max-width: 120px; display: inline-block;")= log.tibicotransactionid
                  else
                    span.text-muted.fst-italic —
                td
                  if log.metadata && Object.keys(log.metadata).length > 0
                    button.btn.btn-sm.btn-outline-primary(onclick=`showMetadata('${log._id}')`)
                      i.fas.fa-eye.me-1
                      | View
                  else
                    span.text-muted.fst-italic —
                td
                  if log.metadata && (log.metadata.response || log.metadata.payload)
                    button.btn.btn-sm.btn-outline-success(onclick=`showPayload('${log._id}')`)
                      i.fas.fa-eye.me-1
                      | View
                  else
                    span.text-muted.fst-italic —
            
            if logs.length === 0
              tr
                td.text-center.py-5(colspan="7")
                  .text-muted
                    i.fas.fa-inbox.fs-1.mb-3.d-block(style="opacity: 0.3;")
                    p.mb-0.fw-medium No logs found
                    small Try adjusting your search criteria
      
      // Pagination (if needed)
      if totalPages > 1
        nav.mt-4.card-section.py-3
          .d-flex.justify-content-between.align-items-center
            span.text-muted.small Page #{currentPage} of #{totalPages}
            ul.pagination.mb-0
              if currentPage > 1
                li.page-item
                  a.page-link(href=`/logs?page=${currentPage - 1}&search=${searchQuery || ''}&type=${searchType || ''}`)
                    i.fas.fa-chevron-left.me-1
                    | Previous
              
              - let startPage = Math.max(1, currentPage - 2)
              - let endPage = Math.min(totalPages, currentPage + 2)
              
              each pageNum in Array.from({length: endPage - startPage + 1}, (_, i) => startPage + i)
                li.page-item(class=pageNum === currentPage ? 'active' : '')
                  a.page-link(href=`/logs?page=${pageNum}&search=${searchQuery || ''}&type=${searchType || ''}`)= pageNum
              
              if currentPage < totalPages
                li.page-item
                  a.page-link(href=`/logs?page=${currentPage + 1}&search=${searchQuery || ''}&type=${searchType || ''}`)
                    | Next
                    i.fas.fa-chevron-right.ms-1
            
            if currentPage < totalPages
              li.page-item
                a.page-link(href=`/logs?page=${currentPage + 1}&search=${searchQuery || ''}&type=${searchType || ''}`) Next

  // Modal for JSON viewing
  .modal.fade#jsonModal(tabindex="-1")
    .modal-dialog.modal-xl
      .modal-content
        .modal-header
          h5.modal-title JSON Viewer
          button.btn-close(type="button" data-bs-dismiss="modal")
        .modal-body
          pre.json-viewer#jsonContent
            code.language-json

  script.
    // Store logs data for modal viewing (safely)
    let logsData = [];
    try {
      logsData = !{JSON.stringify(logs || [])};
    } catch(e) {
      console.error('Error parsing logs data:', e);
    }
    
    function showMetadata(logId) {
      try {
        const log = logsData.find(l => l._id === logId);
        if (log && log.metadata) {
          document.getElementById('jsonContent').querySelector('code').textContent = JSON.stringify(log.metadata, null, 2);
          document.querySelector('#jsonModal .modal-title').textContent = 'Metadata Viewer';
          new bootstrap.Modal(document.getElementById('jsonModal')).show();
          Prism.highlightAll();
        }
      } catch(e) {
        console.error('Error showing metadata:', e);
      }
    }
    
    function showPayload(logId) {
      try {
        const log = logsData.find(l => l._id === logId);
        if (log && log.metadata) {
          const payload = log.metadata.response || log.metadata.payload || log.metadata;
          document.getElementById('jsonContent').querySelector('code').textContent = JSON.stringify(payload, null, 2);
          document.querySelector('#jsonModal .modal-title').textContent = 'Payload Viewer';
          new bootstrap.Modal(document.getElementById('jsonModal')).show();
          Prism.highlightAll();
        }
      } catch(e) {
        console.error('Error showing payload:', e);
      }
    }

    // Auto-highlight JSON
    document.addEventListener('DOMContentLoaded', function() {
      try {
        Prism.highlightAll();
      } catch(e) {
        console.error('Error highlighting code:', e);
      }
    });
    
    // Check if we should show loader on page load (coming from search)
    if (sessionStorage.getItem('showLoader') === 'true') {
      sessionStorage.removeItem('showLoader');
    }
    
    // Handle form submission
    const searchForm = document.getElementById('searchForm');
    if (searchForm) {
      searchForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const searchInput = document.getElementById('searchInput').value;
        const searchType = document.querySelector('input[name="searchType"]:checked').value;
        
        // Show loader, hide results
        document.getElementById('searchLoader').style.display = 'block';
        document.getElementById('resultsContainer').style.display = 'none';
        document.querySelector('.table-container').style.display = 'none';
        
        // Also hide pagination if present
        const pagination = document.querySelector('nav.mt-4');
        if (pagination) pagination.style.display = 'none';
        
        // Mark that we're loading
        sessionStorage.setItem('showLoader', 'true');
        
        const url = new URL('/logs', window.location.origin);
        if (searchInput.trim()) {
          url.searchParams.set('search', searchInput.trim());
          url.searchParams.set('type', searchType);
        }
        
        window.location.href = url.toString();
      });
    }
    
    // Handle pagination clicks with loader
    document.querySelectorAll('.pagination .page-link').forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        document.getElementById('searchLoader').style.display = 'block';
        document.getElementById('resultsContainer').style.display = 'none';
        document.querySelector('.table-container').style.display = 'none';
        const pagination = document.querySelector('nav.mt-4');
        if (pagination) pagination.style.display = 'none';
        window.location.href = this.href;
      });
    });