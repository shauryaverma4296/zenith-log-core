extends layout

block content
  .kibana-main
    //- Sidebar
    .kibana-sidebar
      .sidebar-section
        .sidebar-title Filters
        .sidebar-item.active
          i.fas.fa-stream
          span All Logs
        .sidebar-item
          i.fas.fa-exclamation-circle
          span Errors Only
        .sidebar-item
          i.fas.fa-exclamation-triangle
          span Warnings
        .sidebar-item
          i.fas.fa-info-circle
          span Info
      
      .sidebar-section
        .sidebar-title Quick Stats
        .field-row
          .field-name Total Logs
          .field-value= logs.length
        .field-row
          .field-name Current Page
          .field-value= currentPage || 1
        .field-row
          .field-name Total Pages
          .field-value= totalPages || 1
    
    //- Main Content
    .kibana-content
      //- Search Bar
      form#searchForm
        .search-bar
          .search-input-wrapper
            i.fas.fa-search.search-icon
            input#searchInput.search-input(
              type="text"
              placeholder="Search by correlation ID, transaction ID, or unit name..."
              value=searchQuery || ""
            )
          
          .filter-pills
            label.filter-pill(class=searchType === 'correlationId' || !searchType ? 'active' : '')
              input(type="radio" name="searchType" value="correlationId" checked=searchType === 'correlationId' || !searchType style="display: none;")
              i.fas.fa-link
              span Correlation ID
            label.filter-pill(class=searchType === 'tibcoTransactionId' ? 'active' : '')
              input(type="radio" name="searchType" value="tibcoTransactionId" checked=searchType === 'tibcoTransactionId' style="display: none;")
              i.fas.fa-exchange-alt
              span Transaction ID
            label.filter-pill(class=searchType === 'unitName' ? 'active' : '')
              input(type="radio" name="searchType" value="unitName" checked=searchType === 'unitName' style="display: none;")
              i.fas.fa-cube
              span Unit Name
          
          button.btn-kibana(type="submit")
            i.fas.fa-search.me-2
            | Search
          
          if searchQuery
            a.btn-kibana-secondary(href="/logs")
              i.fas.fa-times.me-2
              | Clear
      
      //- Results Header
      .results-header
        .results-count
          if searchQuery
            span Found 
            strong #{logs.length}
            span  results for "#{searchQuery}"
          else
            span Showing 
            strong #{logs.length}
            span  log entries
        .results-count
          span Updated: 
          strong= new Date().toLocaleTimeString()
      
      //- Loading Overlay
      #loadingOverlay.loading-overlay
        .spinner
        span.text-muted Searching logs...
      
      //- Logs Table
      if logs.length > 0
        table.log-table
          thead
            tr
              th(style="width: 30px;")
              th Timestamp
              th Level
              th Message
              th Correlation ID
              th Transaction ID
          tbody
            each log, index in logs
              tr.log-row(onclick=`toggleRow(${index})` data-index=index)
                td.expand-icon
                  i.fas.fa-chevron-right
                td.log-timestamp
                  div= new Date(log.timestamp).toLocaleString()
                td
                  span.log-level(class=`log-level-${log.level}`)= log.level.toUpperCase()
                td.log-message= log.message
                td.log-id(title=log.correlationId || '')= log.correlationId || '—'
                td.log-id(title=log.tibcoTransactionId || '')= log.tibcoTransactionId || '—'
              
              tr.log-details(data-detail-index=index)
                td(colspan="6")
                  .log-details-content
                    .detail-tabs
                      .detail-tab.active(onclick=`showTab(${index}, 'table')` data-tab="table") Table
                      .detail-tab(onclick=`showTab(${index}, 'json')` data-tab="json") JSON
                    
                    .detail-panel(data-panel="table")
                      .field-row
                        .field-name Timestamp
                        .field-value= new Date(log.timestamp).toISOString()
                      .field-row
                        .field-name Level
                        .field-value= log.level
                      .field-row
                        .field-name Event
                        .field-value= log.event
                      .field-row
                        .field-name Message
                        .field-value= log.message
                      .field-row
                        .field-name Correlation ID
                        .field-value= log.correlationId || '—'
                      .field-row
                        .field-name Transaction ID
                        .field-value= log.tibcoTransactionId || '—'
                      if log.metadata && log.metadata.payload && log.metadata.payload.unitName
                        .field-row
                          .field-name Unit Name
                          .field-value= log.metadata.payload.unitName
                      .field-row
                        .field-name Event
                        .field-value= log.event || '—'
                    
                    .detail-panel(data-panel="json" style="display: none;")
                      pre.json-viewer
                        code#json-#{`${index}`}
      else
        .empty-state
          i.fas.fa-inbox
          h3 No logs found
          p Try adjusting your search criteria or check back later
      
      //- Pagination
      if totalPages > 1
        .pagination-bar
          .page-info Page #{currentPage} of #{totalPages}
          .page-buttons
            if currentPage > 1
              a.page-btn(href=`/logs?page=${currentPage - 1}&search=${searchQuery || ''}&type=${searchType || ''}`)
                i.fas.fa-chevron-left
            
            - let startPage = Math.max(1, currentPage - 2)
            - let endPage = Math.min(totalPages, currentPage + 2)
            
            each pageNum in Array.from({length: endPage - startPage + 1}, (_, i) => startPage + i)
              a.page-btn(href=`/logs?page=${pageNum}&search=${searchQuery || ''}&type=${searchType || ''}` class=pageNum === currentPage ? 'active' : '')= pageNum
            
            if currentPage < totalPages
              a.page-btn(href=`/logs?page=${currentPage + 1}&search=${searchQuery || ''}&type=${searchType || ''}`)
                i.fas.fa-chevron-right

  script.
    // Store logs data
    let logsData = [];
    try {
      logsData = !{JSON.stringify(logs || [])};
    } catch(e) {
      console.error('Error parsing logs:', e);
    }
    
    // Syntax highlight JSON
    function syntaxHighlight(json) {
      if (typeof json !== 'string') {
        json = JSON.stringify(json, null, 2);
      }
      json = json.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      return json.replace(/("(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d*)?(?:[eE][+\-]?\d+)?)/g, function (match) {
        let cls = 'json-number';
        if (/^"/.test(match)) {
          if (/:$/.test(match)) {
            cls = 'json-key';
          } else {
            cls = 'json-string';
          }
        } else if (/true|false/.test(match)) {
          cls = 'json-boolean';
        } else if (/null/.test(match)) {
          cls = 'json-null';
        }
        return '<span class="' + cls + '">' + match + '</span>';
      });
    }
    
    // Toggle row expansion
    function toggleRow(index) {
      const row = document.querySelector(`.log-row[data-index="${index}"]`);
      const details = document.querySelector(`.log-details[data-detail-index="${index}"]`);
      
      // Close other rows
      document.querySelectorAll('.log-row.expanded').forEach(r => {
        if (r !== row) r.classList.remove('expanded');
      });
      document.querySelectorAll('.log-details.show').forEach(d => {
        if (d !== details) d.classList.remove('show');
      });
      
      row.classList.toggle('expanded');
      details.classList.toggle('show');
      
      // Populate JSON if not done
      const jsonCode = document.getElementById('json-' + index);
      if (jsonCode && !jsonCode.innerHTML) {
        jsonCode.innerHTML = syntaxHighlight(logsData[index]);
      }
    }
    
    // Tab switching
    function showTab(index, tab) {
      const details = document.querySelector(`.log-details[data-detail-index="${index}"]`);
      details.querySelectorAll('.detail-tab').forEach(t => {
        t.classList.toggle('active', t.dataset.tab === tab);
      });
      details.querySelectorAll('.detail-panel').forEach(p => {
        p.style.display = p.dataset.panel === tab ? 'block' : 'none';
      });
    }
    
    // Filter pills toggle
    document.querySelectorAll('.filter-pill').forEach(pill => {
      pill.addEventListener('click', function() {
        document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
        this.classList.add('active');
      });
    });
    
    // Form submission
    const searchForm = document.getElementById('searchForm');
    if (searchForm) {
      searchForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const searchInput = document.getElementById('searchInput').value;
        const searchType = document.querySelector('.filter-pill.active input').value;
        
        document.getElementById('loadingOverlay').classList.add('show');
        
        const url = new URL('/logs', window.location.origin);
        if (searchInput.trim()) {
          url.searchParams.set('search', searchInput.trim());
          url.searchParams.set('type', searchType);
        }
        
        window.location.href = url.toString();
      });
    }
