extends layout

block content
  .kibana-main
    //- Sidebar
    .kibana-sidebar
      .sidebar-section
        .sidebar-title Filters
        a.sidebar-item(href=`/logs?level=all&search=${searchQuery || ''}&type=${searchType || ''}` class=(!levelFilter || levelFilter === 'all') ? 'active' : '')
          i.fas.fa-stream
          span All Logs
        a.sidebar-item(href=`/logs?level=error&search=${searchQuery || ''}&type=${searchType || ''}` class=levelFilter === 'error' ? 'active' : '')
          i.fas.fa-exclamation-circle
          span Errors Only
        a.sidebar-item(href=`/logs?level=warn&search=${searchQuery || ''}&type=${searchType || ''}` class=levelFilter === 'warn' ? 'active' : '')
          i.fas.fa-exclamation-triangle
          span Warnings
        a.sidebar-item(href=`/logs?level=info&search=${searchQuery || ''}&type=${searchType || ''}` class=levelFilter === 'info' ? 'active' : '')
          i.fas.fa-info-circle
          span Info
        a.sidebar-item(href=`/logs?level=debug&search=${searchQuery || ''}&type=${searchType || ''}` class=levelFilter === 'debug' ? 'active' : '')
          i.fas.fa-bug
          span Debug
      
      .sidebar-section
        .sidebar-title Quick Stats
        .field-row
          .field-name Total Logs
          .field-value= logs.length
        .field-row
          .field-name Current Page
          .field-value= currentPage || 1
        .field-row
          .field-name Total Pages
          .field-value= totalPages || 1
    
    //- Main Content
    .kibana-content
      //- Search Bar
      form#searchForm
        .search-bar
          .search-input-wrapper
            i.fas.fa-search.search-icon
            input#searchInput.search-input(
              type="text"
              placeholder="Search by correlation ID, transaction ID, or unit name..."
              value=searchQuery || ""
            )
          
          .filter-pills
            label.filter-pill(class=searchType === 'correlationId' || !searchType ? 'active' : '')
              input(type="radio" name="searchType" value="correlationId" checked=searchType === 'correlationId' || !searchType style="display: none;")
              i.fas.fa-link
              span Correlation ID
            label.filter-pill(class=searchType === 'tibcoTransactionId' ? 'active' : '')
              input(type="radio" name="searchType" value="tibcoTransactionId" checked=searchType === 'tibcoTransactionId' style="display: none;")
              i.fas.fa-exchange-alt
              span Transaction ID
            label.filter-pill(class=searchType === 'unitName' ? 'active' : '')
              input(type="radio" name="searchType" value="unitName" checked=searchType === 'unitName' style="display: none;")
              i.fas.fa-cube
              span Unit Name
          
          button.btn-kibana(type="submit")
            i.fas.fa-search.me-2
            | Search
          
          if searchQuery
            a.btn-kibana-secondary(href="/logs")
              i.fas.fa-times.me-2
              | Clear
      
      //- Results Header
      .results-header
        .results-count
          if searchQuery
            span Found 
            strong #{logs.length}
            span  results for "#{searchQuery}"
          else
            span Showing 
            strong #{logs.length}
            span  log entries
        .results-count
          span Updated: 
          strong= new Date().toLocaleTimeString()
      
      //- Loader
      #loadingOverlay.loading-overlay
        .spinner
        span.text-muted Searching logs...
      
      //- Logs Table Container
      .logs-table-container
        if logs.length > 0
          table.log-table
            thead
              tr
                th(style="width: 30px;")
                th Timestamp
                th Level
                th Event
                th Message
                th Correlation ID
                th Transaction ID
            tbody
              each log, index in logs
                tr.log-row(onclick=`toggleRow(${index})` data-index=index)
                  td.expand-icon
                    i.fas.fa-chevron-right
                  td.log-timestamp
                    div= new Date(log.timestamp).toLocaleString()
                  td
                    span.log-level(class=`log-level-${log.level}`)= log.level.toUpperCase()
                  td.log-event= log.event
                  td.log-message= log.message
                  td.log-id(title=log.correlationId || '')= log.correlationId || '—'
                  td.log-id(title=log.tibcoTransactionId || '')= log.tibcoTransactionId || '—'
                
                tr.log-details(data-detail-index=index)
                  td(colspan="6")
                    .log-details-content
                      .detail-tabs
                        .detail-tab.active(onclick=`showTab(${index}, 'table')` data-tab="table") 
                          i.fas.fa-table
                          | Table
                        .detail-tab(onclick=`showTab(${index}, 'metadata')` data-tab="metadata")
                          i.fas.fa-database
                          | Metadata
                        .detail-tab(onclick=`showTab(${index}, 'payload')` data-tab="payload")
                          i.fas.fa-file-code
                          | Payload
                        .detail-tab(onclick=`showTab(${index}, 'json')` data-tab="json")
                          i.fas.fa-code
                          | Full JSON
                      
                      .detail-panel(data-panel="table")
                        .field-row
                          .field-name Timestamp
                          .field-value= new Date(log.timestamp).toISOString()
                        .field-row
                          .field-name Level
                          .field-value= log.level
                        .field-row
                          .field-name Event
                          .field-value= log.event || '—'
                        .field-row
                          .field-name Message
                          .field-value= log.message
                        .field-row
                          .field-name Correlation ID
                          .field-value= log.correlationId || '—'
                        .field-row
                          .field-name Transaction ID
                          .field-value= log.tibcoTransactionId || '—'
                        if log.metadata && log.metadata.payload && log.metadata.payload.unitName
                          .field-row
                            .field-name Unit Name
                            .field-value= log.metadata.payload.unitName
                      
                      .detail-panel(data-panel="metadata" style="display: none;")
                        .json-panel-header
                          span Metadata
                          button.copy-btn(type="button" onclick=`copyJson(${index}, 'metadata')`)
                            i.fas.fa-copy
                            | Copy
                        pre.json-viewer
                          code(id=`metadata-${index}`)
                      
                      .detail-panel(data-panel="payload" style="display: none;")
                        .json-panel-header
                          span Payload
                          button.copy-btn(type="button" onclick=`copyJson(${index}, 'payload')`)
                            i.fas.fa-copy
                            | Copy
                        pre.json-viewer
                          code(id=`payload-${index}`)
                      
                      .detail-panel(data-panel="json" style="display: none;")
                        .json-panel-header
                          span Full Log JSON
                          button.copy-btn(type="button" onclick=`copyJson(${index}, 'full')`)
                            i.fas.fa-copy
                            | Copy
                        pre.json-viewer
                          code(id=`json-${index}`)
        else
          .empty-state
            i.fas.fa-inbox
            h3 No logs found
            p Try adjusting your search criteria or check back later
      
      //- Fixed Pagination
      if totalPages > 1
        .pagination-fixed
          .pagination-bar
            .page-info Page #{currentPage} of #{totalPages}
            .page-buttons
              if currentPage > 1
                a.page-btn(href=`/logs?page=${currentPage - 1}&search=${searchQuery || ''}&type=${searchType || ''}&level=${levelFilter || ''}`)
                  i.fas.fa-chevron-left
              
              - let startPage = Math.max(1, currentPage - 2)
              - let endPage = Math.min(totalPages, currentPage + 2)
              
              each pageNum in Array.from({length: endPage - startPage + 1}, (_, i) => startPage + i)
                a.page-btn(href=`/logs?page=${pageNum}&search=${searchQuery || ''}&type=${searchType || ''}&level=${levelFilter || ''}` class=pageNum === currentPage ? 'active' : '')= pageNum
              
              if currentPage < totalPages
                a.page-btn(href=`/logs?page=${currentPage + 1}&search=${searchQuery || ''}&type=${searchType || ''}&level=${levelFilter || ''}`)
                  i.fas.fa-chevron-right

  //- Toast notification
  #copyToast.copy-toast
    i.fas.fa-check-circle
    span Copied to clipboard!

  script.
    // Store logs data
    let logsData = [];
    try {
      logsData = !{JSON.stringify(logs || [])};
    } catch(e) {
      console.error('Error parsing logs:', e);
    }
    
    // Syntax highlight JSON
    function syntaxHighlight(json) {
      if (typeof json !== 'string') {
        json = JSON.stringify(json, null, 2);
      }
      json = json.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      return json.replace(/("(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d*)?(?:[eE][+\-]?\d+)?)/g, function (match) {
        let cls = 'json-number';
        if (/^"/.test(match)) {
          if (/:$/.test(match)) {
            cls = 'json-key';
          } else {
            cls = 'json-string';
          }
        } else if (/true|false/.test(match)) {
          cls = 'json-boolean';
        } else if (/null/.test(match)) {
          cls = 'json-null';
        }
        return '<span class="' + cls + '">' + match + '</span>';
      });
    }
    
    // Copy JSON to clipboard
    function copyJson(index, type) {
      let data;
      if (type === 'metadata') {
        data = logsData[index].metadata || {};
      } else if (type === 'payload') {
        data = logsData[index].metadata?.payload || {};
      } else {
        data = logsData[index];
      }
      
      navigator.clipboard.writeText(JSON.stringify(data, null, 2)).then(() => {
        showToast();
      }).catch(err => {
        console.error('Failed to copy:', err);
      });
    }
    
    // Show toast notification
    function showToast() {
      const toast = document.getElementById('copyToast');
      toast.classList.add('show');
      setTimeout(() => {
        toast.classList.remove('show');
      }, 2000);
    }
    
    // Toggle row expansion
    function toggleRow(index) {
      const row = document.querySelector(`.log-row[data-index="${index}"]`);
      const details = document.querySelector(`.log-details[data-detail-index="${index}"]`);
      
      // Close other rows
      document.querySelectorAll('.log-row.expanded').forEach(r => {
        if (r !== row) r.classList.remove('expanded');
      });
      document.querySelectorAll('.log-details.show').forEach(d => {
        if (d !== details) d.classList.remove('show');
      });
      
      row.classList.toggle('expanded');
      details.classList.toggle('show');
      
      // Populate JSON panels if not done
      const jsonCode = document.getElementById('json-' + index);
      const metadataCode = document.getElementById('metadata-' + index);
      const payloadCode = document.getElementById('payload-' + index);
      
      if (jsonCode && !jsonCode.innerHTML) {
        jsonCode.innerHTML = syntaxHighlight(logsData[index]);
      }
      if (metadataCode && !metadataCode.innerHTML) {
        metadataCode.innerHTML = syntaxHighlight(logsData[index].metadata || {});
      }
      if (payloadCode && !payloadCode.innerHTML) {
        payloadCode.innerHTML = syntaxHighlight(logsData[index].metadata?.payload || {});
      }
    }
    
    // Tab switching
    function showTab(index, tab) {
      const details = document.querySelector(`.log-details[data-detail-index="${index}"]`);
      details.querySelectorAll('.detail-tab').forEach(t => {
        t.classList.toggle('active', t.dataset.tab === tab);
      });
      details.querySelectorAll('.detail-panel').forEach(p => {
        p.style.display = p.dataset.panel === tab ? 'block' : 'none';
      });
    }
    
    // Filter pills toggle
    document.querySelectorAll('.filter-pill').forEach(pill => {
      pill.addEventListener('click', function() {
        document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
        this.classList.add('active');
      });
    });
    
    // Form submission
    const searchForm = document.getElementById('searchForm');
    if (searchForm) {
      searchForm.addEventListener('submit', function(e) {
        e.preventDefault();
        const searchInput = document.getElementById('searchInput').value;
        const searchType = document.querySelector('.filter-pill.active input').value;
        
        document.getElementById('loadingOverlay').classList.add('show');
        
        const url = new URL('/logs', window.location.origin);
        if (searchInput.trim()) {
          url.searchParams.set('search', searchInput.trim());
          url.searchParams.set('type', searchType);
        }
        
        // Preserve level filter
        const currentLevel = new URLSearchParams(window.location.search).get('level');
        if (currentLevel) {
          url.searchParams.set('level', currentLevel);
        }
        
        window.location.href = url.toString();
      });
    }
