extends layout

block content
  style.
    .select-header {
      background: var(--kibana-header);
      border-bottom: 1px solid var(--kibana-border);
      padding: 0 24px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .select-header .brand {
      display: flex; align-items: center; gap: 10px;
      font-weight: 600; font-size: 15px;
    }
    .select-header .brand i { color: var(--kibana-accent); }
    .select-user {
      display: flex; align-items: center; gap: 12px;
      font-size: 12px; color: var(--kibana-text-muted);
    }
    .logout-btn {
      background: transparent; border: 1px solid var(--kibana-border);
      color: var(--kibana-text); padding: 6px 12px; border-radius: 6px;
      cursor: pointer; font-size: 12px; display: inline-flex; align-items: center; gap: 6px;
    }
    .logout-btn:hover { border-color: var(--kibana-accent); color: var(--kibana-accent); }
    .select-wrap {
      max-width: 960px; margin: 0 auto; padding: 64px 24px;
    }
    .select-title { font-size: 28px; font-weight: 700; margin: 0 0 8px; }
    .select-sub { color: var(--kibana-text-muted); margin: 0 0 32px; font-size: 14px; }
    .tools-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 20px;
    }
    .tool-tile {
      display: block; background: var(--kibana-sidebar);
      border: 1px solid var(--kibana-border); border-radius: 10px;
      padding: 24px; text-decoration: none; color: inherit;
      transition: all 0.2s; position: relative;
    }
    .tool-tile.enabled:hover {
      border-color: var(--kibana-accent);
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(0,0,0,0.25);
    }
    .tool-tile.disabled {
      opacity: 0.5; cursor: not-allowed; pointer-events: none;
    }
    .tool-icon-wrap {
      width: 48px; height: 48px; border-radius: 8px;
      background: rgba(54,162,239,0.12);
      display: flex; align-items: center; justify-content: center;
      color: var(--kibana-accent); font-size: 22px; margin-bottom: 16px;
    }
    .tool-name { font-size: 16px; font-weight: 600; margin: 0 0 6px; }
    .tool-desc { font-size: 13px; color: var(--kibana-text-muted); margin: 0; }
    .tool-lock {
      position: absolute; top: 16px; right: 16px;
      color: var(--kibana-text-muted); font-size: 14px;
    }
    .no-access-note {
      margin-top: 12px; font-size: 11px; color: var(--kibana-text-muted);
      font-style: italic;
    }

  .select-header
    .brand
      i.fas.fa-layer-group
      span Logger Dashboard
    .select-user
      if username
        span Signed in as #[strong(style="color: var(--kibana-text);")= username]
      form(method="POST" action="/auth/logout" style="display:inline;")
        button.logout-btn(type="submit")
          i.fas.fa-sign-out-alt
          span Logout

  .select-wrap
    h1.select-title Where would you like to go?
    p.select-sub Choose a tool below. Tiles you don't have access to are disabled.

    .tools-grid
      each tool in (tools || [])
        a.tool-tile(href=tool.allowed ? tool.href : '#' class=tool.allowed ? 'enabled' : 'disabled' aria-disabled=!tool.allowed)
          if !tool.allowed
            i.fas.fa-lock.tool-lock
          .tool-icon-wrap
            i(class="fas " + tool.icon)
          h2.tool-name= tool.name
          p.tool-desc= tool.desc
          if !tool.allowed
            p.no-access-note No access — contact an administrator.
